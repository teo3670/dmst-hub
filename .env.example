# Copy to .env.local — never commit .env.local

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Email verification
RESEND_API_KEY=
OTP_FROM_EMAIL="DET Hub <verify@example.org>"
# Random 32+ byte secret used to HMAC the OTP codes: `openssl rand -base64 32`
OTP_SECRET=
# Regex for accepted institutional emails (see docs/ARCHITECTURE.md → open questions)
DET_EMAIL_PATTERN=^[^@\s]+@aueb\.gr$

NEXT_PUBLIC_SITE_URL=http://localhost:3000
